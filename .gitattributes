# Normaliza finales de línea en el repositorio
* text=auto

# Archivos que se ejecutan en Linux (EC2): siempre LF,
# incluso si se clona en Windows
*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.env     text eol=lf
deploy/** text eol=lf

# Binarios
*.zip binary
*.png binary
*.jpg binary
